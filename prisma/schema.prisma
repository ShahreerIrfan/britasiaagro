generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_NEGOTIATION
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  desc             String
  image            String
  category         String   // "commodities", "steel", "agro"
  badge            String   // "Bulk Commodities", "Steel & Metals", "Agriculture"
  breed            String?  // Breed / Species / Variety
  farmingMethod    String?  // Farming & Husbandry Method
  processingMethod String?  // Processing & Cold-Chain Technology
  packaging        String?  // Available Cuts & Packaging Formats
  certifications   String?  // Certifications & Compliance
  logistics        String?  // Export Logistics & Shipping
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TradeInquiry {
  id        String        @id @default(cuid())
  commodity String
  volume    String
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
